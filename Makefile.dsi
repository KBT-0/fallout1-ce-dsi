# Fallout 1 CE — Nintendo DSi builds
#
# Purpose:
#   Keep the accepted Phase 0A lower-bound probes and build the real DSi
#   runtime image from the same Fallout CE engine source set.
#
# The feasibility targets remain LOWER BOUND probes; `dsi-game` is the
# production runtime target.
# Expected outputs:
#   build/fallout1-dsi-feasibility.elf
#   build/fallout1-dsi-feasibility.map
#   build/fallout1-dsi.nds

.SUFFIXES:

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif

TOPDIR := $(CURDIR)
include $(DEVKITARM)/ds_rules
.DEFAULT_GOAL := feasibility

# devkitPro's shell setup normally exports these. Resolve them from DEVKITARM
# as a fallback so the target also works in the official container image.
ifeq ($(strip $(DEVKITPRO)),)
DEVKITPRO := $(abspath $(DEVKITARM)/..)
endif
ifeq ($(strip $(LIBNDS)),)
LIBNDS := $(DEVKITPRO)/libnds
endif
ifeq ($(strip $(PORTLIBS)),)
PORTLIBS := $(DEVKITPRO)/portlibs/nds
endif

# -----------------------------------------------------------------------------
# Output contract consumed by .github/workflows/dsi-size.yml
# -----------------------------------------------------------------------------
BUILD      := build
CONFIG     ?= optimized

ifeq ($(CONFIG),baseline)
OBJDIR     := $(BUILD)/feasibility_obj_baseline
TARGET     := fallout1-dsi-feasibility-baseline
SECTION_FLAGS :=
GC_LDFLAGS :=
BUILD_DEFINES := -DFALLOUT_DSI_FEASIBILITY=1
else ifeq ($(CONFIG),optimized)
OBJDIR     := $(BUILD)/feasibility_obj
TARGET     := fallout1-dsi-feasibility
SECTION_FLAGS := -ffunction-sections -fdata-sections
GC_LDFLAGS := -Wl,--gc-sections
BUILD_DEFINES := -DFALLOUT_DSI_FEASIBILITY=1
else ifeq ($(CONFIG),game)
OBJDIR     := $(BUILD)/dsi_game_obj
TARGET     := fallout1-dsi
SECTION_FLAGS := -ffunction-sections -fdata-sections
GC_LDFLAGS := -Wl,--gc-sections
BUILD_DEFINES := -D__DSI__=1 -DFALLOUT_DSI_GAME=1
else
$(error "CONFIG must be 'baseline', 'optimized', or 'game'")
endif

ELF        := $(BUILD)/$(TARGET).elf
MAP        := $(BUILD)/$(TARGET).map
NDS        := $(BUILD)/$(TARGET).nds
ARM7_ELF   := $(CALICO)/bin/ds7_maine.elf
ICON       := $(CALICO)/share/nds-icon.bmp

# -----------------------------------------------------------------------------
# Source layout mirrors the maintained 3DS Makefile's Fallout core directories,
# but deliberately excludes src/platform/ctr and substitutes the Phase 0 DSi
# feasibility shim.
# -----------------------------------------------------------------------------
CORE_DIRS := \
	src \
	src/game \
	src/int \
	src/int/support \
	src/plib/assoc \
	src/plib/color \
	src/plib/db \
	src/plib/gnw \
	third_party/fpattern/vendor

FEAS_DIR := src/platform/dsi/feasibility
RUNTIME_DIR := src/platform/dsi/runtime
SOURCE_DIRS := $(CORE_DIRS) $(FEAS_DIR) $(RUNTIME_DIR)

CORE_C_SOURCES   := $(foreach d,$(CORE_DIRS),$(wildcard $(d)/*.c))
CORE_CC_SOURCES  := $(foreach d,$(CORE_DIRS),$(wildcard $(d)/*.cc))
CORE_CPP_SOURCES := $(foreach d,$(CORE_DIRS),$(wildcard $(d)/*.cpp))
STUB_C_SOURCES   := $(wildcard $(FEAS_DIR)/*.c)
STUB_CC_SOURCES  := $(wildcard $(FEAS_DIR)/*.cc)
STUB_CPP_SOURCES := $(wildcard $(FEAS_DIR)/*.cpp)
RUNTIME_C_SOURCES   := $(wildcard $(RUNTIME_DIR)/*.c)
RUNTIME_CC_SOURCES  := $(wildcard $(RUNTIME_DIR)/*.cc)
RUNTIME_CPP_SOURCES := $(wildcard $(RUNTIME_DIR)/*.cpp)
C_SOURCES   := $(CORE_C_SOURCES) $(STUB_C_SOURCES) $(RUNTIME_C_SOURCES)
CC_SOURCES  := $(CORE_CC_SOURCES) $(STUB_CC_SOURCES) $(RUNTIME_CC_SOURCES)
CPP_SOURCES := $(CORE_CPP_SOURCES) $(STUB_CPP_SOURCES) $(RUNTIME_CPP_SOURCES)

C_OBJECTS   := $(patsubst %.c,$(OBJDIR)/%.o,$(C_SOURCES))
CC_OBJECTS  := $(patsubst %.cc,$(OBJDIR)/%.o,$(CC_SOURCES))
CPP_OBJECTS := $(patsubst %.cpp,$(OBJDIR)/%.o,$(CPP_SOURCES))
OBJECTS     := $(C_OBJECTS) $(CC_OBJECTS) $(CPP_OBJECTS)
DEPS        := $(OBJECTS:.o=.d)

# -----------------------------------------------------------------------------
# ARM9 target settings copied from the current official devkitPro DS ARM9
# template. Do NOT import the 3DS fork's ARMv6K/mpcore/hard-float flags.
# -----------------------------------------------------------------------------
ARCH := -march=armv5te -mtune=arm946e-s

COMMON_FLAGS := \
	-g \
	-Wall \
	-Os \
	$(SECTION_FLAGS) \
	-fomit-frame-pointer \
	$(ARCH)

# Keep C++ ABI overhead conservative for the first lower-bound link, matching
# the 3DS port's no-RTTI/no-exceptions policy while retaining GNU++17.
CFLAGS   := $(COMMON_FLAGS)
CXXFLAGS := $(COMMON_FLAGS) -fno-rtti -fno-exceptions -std=gnu++17

# Stub include path MUST be first so <SDL.h> resolves to the feasibility shim.
FEAS_INCLUDE := $(TOPDIR)/$(FEAS_DIR)/include

INCLUDE_FLAGS := \
	-I$(FEAS_INCLUDE) \
	$(foreach d,$(CORE_DIRS),-I$(TOPDIR)/$(d)) \
	-I$(LIBNDS)/include \
	-I$(CALICO)/include

ifneq ($(strip $(PORTLIBS)),)
INCLUDE_FLAGS += $(foreach d,$(PORTLIBS),-I$(d)/include)
endif

CPPFLAGS := \
	$(INCLUDE_FLAGS) \
	-DARM9 \
	-D__NDS__ \
	-Dunix \
	$(BUILD_DEFINES) \
	-DSDL_MAIN_HANDLED

# Current ds_rules translates ds_arm9.specs to Calico's DS9 runtime specs and
# appends libcalico_ds9 for implicit links. This explicit link recipe must make
# the same contract visible itself.
LDFLAGS := \
	-specs=$(CALICO)/share/ds9.specs \
	-g \
	$(ARCH) \
	$(GC_LDFLAGS) \
	-Wl,--cref \
	-Wl,-Map,$(abspath $(MAP))

# Do not use devkitPro's generic LIBPATHS name here: ds_rules owns it and may
# rewrite it from LIBDIRS. Keep this feasibility link's paths isolated.
FEAS_LIBPATHS := -L$(LIBNDS)/lib
FEAS_LIBPATHS += $(foreach d,$(PORTLIBS),-L$(d)/lib)
FEAS_LIBPATHS += -L$(CALICO)/lib

# Fallout CE's maintained 3DS build links zlib. nds-zlib is supplied through
# devkitPro portlibs; CI attempts to install it when absent.
LIBS := -lfat -lz -lnds9 -lcalico_ds9 -lm

.PHONY: all feasibility feasibility-all feasibility-baseline dsi-game game-image clean print-feasibility-config

all: feasibility

# PROJECT_v3 §5 requires both a conservative baseline and the section-GC
# optimized lower bound. The exact optimized ELF name remains the CI contract.
feasibility-all:
	$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) CONFIG=baseline feasibility
	$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) CONFIG=optimized feasibility

feasibility-baseline:
	$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) CONFIG=baseline feasibility

dsi-game:
	$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) CONFIG=game game-image

game-image: print-feasibility-config $(NDS)
	@echo
	@echo "DSi game ELF: $(ELF)"
	@echo "DSi game map: $(MAP)"
	@echo "DSi game NDS: $(NDS)"

# Explicit target required by PROJECT_v3 §5/§32 and the CI workflow.
feasibility: print-feasibility-config $(ELF)
	@echo
	@echo "Feasibility ELF: $(ELF)"
	@echo "Linker map:     $(MAP)"
	@echo "RESULT CLASS:   LOWER BOUND"

print-feasibility-config:
	@echo "=== Fallout 1 CE DSi feasibility build ==="
	@echo "DEVKITARM=$(DEVKITARM)"
	@echo "DEVKITPRO=$(DEVKITPRO)"
	@echo "LIBNDS=$(LIBNDS)"
	@echo "PORTLIBS=$(PORTLIBS)"
	@echo "CONFIG=$(CONFIG)"
	@echo "ARCH=$(ARCH)"
	@echo "CXX=$(CXX)"
	@echo "Core source files: $(words $(CORE_C_SOURCES) $(CORE_CC_SOURCES) $(CORE_CPP_SOURCES))"
	@echo "Stub source files: $(words $(STUB_C_SOURCES) $(STUB_CC_SOURCES) $(STUB_CPP_SOURCES))"
	@echo "Runtime source files: $(words $(RUNTIME_C_SOURCES) $(RUNTIME_CC_SOURCES) $(RUNTIME_CPP_SOURCES))"

$(NDS): $(ELF) $(ARM7_ELF) $(ICON)
	@mkdir -p $(dir $@)
	@echo "NDSTOOL $@"
	ndstool -c $@ -9 $(ELF) -7 $(ARM7_ELF) \
		-b $(ICON) "Fallout 1 CE;Nintendo DSi;Main-menu build" \
		-g F1DG 00 "FALLOUT1 DSI"

$(ELF): $(OBJECTS)
	@mkdir -p $(dir $@)
	@echo "LINK $@"
	$(CXX) $(LDFLAGS) $(OBJECTS) $(FEAS_LIBPATHS) $(LIBS) -o $@

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "CC   $<"
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

$(OBJDIR)/%.o: %.cc
	@mkdir -p $(dir $@)
	@echo "CXX  $<"
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "CXX  $<"
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

clean:
	@rm -rf \
		$(BUILD)/feasibility_obj \
		$(BUILD)/feasibility_obj_baseline \
		$(BUILD)/fallout1-dsi-feasibility.elf \
		$(BUILD)/fallout1-dsi-feasibility.map \
		$(BUILD)/fallout1-dsi-feasibility-baseline.elf \
		$(BUILD)/fallout1-dsi-feasibility-baseline.map \
		$(BUILD)/dsi_game_obj \
		$(BUILD)/fallout1-dsi.elf \
		$(BUILD)/fallout1-dsi.map \
		$(BUILD)/fallout1-dsi.nds

-include $(DEPS)
